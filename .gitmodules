[submodule "binutils"]
	path = binutils
	url = https://github.com/gnutools/binutils-gdb
	branch = binutils-2_46
	shallow = true
[submodule "gcc"]
	path = gcc
	url = https://github.com/gcc-mirror/gcc.git
	branch = releases/gcc-16
	shallow = true
[submodule "glibc"]
	path = glibc
	url = https://github.com/gnutools/glibc
	shallow = true
[submodule "dejagnu"]
	path = dejagnu
	url = https://git.savannah.gnu.org/git/dejagnu.git
	branch = master
	shallow = false
[submodule "newlib"]
	path = newlib
	url = https://github.com/cygwin/cygwin
	branch = master
	shallow = true
[submodule "gdb"]
	path = gdb
	url = https://github.com/gnutools/binutils-gdb
	branch = gdb-17.1-release
	shallow = true
[submodule "qemu"]
	path = qemu
	url = https://gitlab.com/qemu-project/qemu.git
	shallow = true
[submodule "musl"]
	path = musl
	url = https://github.com/ifduyue/musl
	branch = master
	shallow = true
[submodule "spike"]
	path = spike
	url = https://github.com/riscv-software-src/riscv-isa-sim.git
	branch = master
	shallow = true
[submodule "pk"]
	path = pk
	url = https://github.com/riscv-software-src/riscv-pk.git
	branch = master
	shallow = true
[submodule "llvm"]
	path = llvm
	url = https://github.com/llvm/llvm-project.git
	branch = release/20.x
	shallow = true
[submodule "uclibc-ng"]
	path = uclibc-ng
	url = https://github.com/wbx-github/uclibc-ng.git
	shallow = true
